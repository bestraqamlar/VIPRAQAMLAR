# ESLATMA: Netlify funksiyalari (/.netlify/functions/...) va Edge Function'lar
# uchun ALOHIDA qoida YOZISH SHART EMAS va Netlify buni RAD ETADI ("path"
# field must not start with "/.netlify") — chunki ular _redirects'dan OLDIN,
# Netlify'ning o'zi tomonidan avtomatik ishlanadi. Pastdagi umumiy "/* ->
# index.html" qoidasi ularga ta'sir qilmaydi.
/assets/*   /assets/:splat   200

# Admin panel manzili — o'zining haqiqiy fayli sifatida ishlaydi (o'zgarishsiz).
/panel-boshqaruv.html   /panel-boshqaruv.html   200

# HAR BIR RAQAM UCHUN ALOHIDA SAHIFA (SEO) — /raqam/998901234567
# Funksiya bazadan raqamni topib, <title>/tavsif/OG teglarni o'sha
# raqamga moslab qaytaradi. Batafsil: netlify/functions/seo-number.js
/raqam/*   /.netlify/functions/seo-number   200

# ULASHISH KARTOCHKASI — har bir raqam uchun chizilgan rasm.
# Telegram/Instagram/WhatsApp havolani ochganda shuni ko'rsatadi.
# Batafsil: netlify/functions/og-raqam.js
/og/raqam/*   /.netlify/functions/og-raqam   200

# Sitemap dinamik — har bir sotuvdagi raqam uchun manzil qo'shiladi.
# Batafsil: netlify/functions/sitemap.js  (eski statik sitemap.xml fayli
# o'chirildi — u shu qoida tufayli baribir hech qachon ko'rsatilmasdi)
/sitemap.xml   /.netlify/functions/sitemap   200

