rules_version = '2';

// FIREBASE STORAGE XAVFSIZLIK QOIDALARI
// Bu faylni Firebase konsolida qo'lda joylashtirish kerak:
// Firebase Console → Build → Storage → Rules → shu matnni joylashtiring → Publish
//
// (Agar "Storage" bo'limi hali yoqilmagan bo'lsa, avval "Get started"
// tugmasini bosib yoqib oling.)

service firebase.storage {
  match /b/{bucket}/o {

    // Mijozlar fikri video sharhlari — hamma ko'ra oladi (saytda
    // ko'rsatiladi), faqat tizimga kirgan admin yuklashi/o'chirishi mumkin.
    match /testimonial_videos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024   // 100 MB dan katta bo'lmasin
        && request.resource.contentType.matches('video/.*');
    }

    // STORIES rasmlari (bosh sahifadagi dumaloq lenta).
    // Hamma ko'ra oladi (saytda ko'rsatiladi), yuklashni faqat tizimga
    // kirgan admin qila oladi. Chegaralar: 9 MB va FAQAT rasm fayli —
    // ya'ni bu yerga video, arxiv yoki skript yuklab bo'lmaydi.
    // (Admin panel rasmni yuborishdan oldin brauzerning o'zida siqadi:
    //  doira uchun 256x256, to'liq ekran uchun 1280 px — shu sabab
    //  haqiqatda yuklanadigan fayl odatda 200 KB atrofida bo'ladi.)
    match /stories/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 9 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // "Premium raqamlar" reklama videolari — hamma ko'ra oladi, faqat
    // admin yuklashi/o'chirishi mumkin.
    match /premium_number_videos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }
  }
}
