rules_version = '2';

// FIREBASE STORAGE XAVFSIZLIK QOIDALARI
// Bu faylni Firebase konsolida qo'lda joylashtirish kerak:
// Firebase Console → Build → Storage → Rules → shu matnni joylashtiring → Publish
//
// (Agar "Storage" bo'limi hali yoqilmagan bo'lsa, avval "Get started"
// tugmasini bosib yoqib oling.)

service firebase.storage {
  match /b/{bucket}/o {

    // ============ V120: XAVFSIZLIK TUZATISHI ============
    // Ilgari bu yerda "request.auth != null" yozilgan edi — ya'ni
    // "tizimga KIRGAN har qanday odam". Izohlarda "faqat admin" deb
    // yozilgan bo'lsa ham, QOIDA buni tekshirmasdi. Agar Firebase
    // Authentication'da Email/Parol provayderida o'z-o'zini
    // ro'yxatdan o'tkazish (self-signup) yoqilgan bo'lsa — bu odatiy
    // standart holat — unda HAR KIM ochiq Web API kaliti bilan o'ziga
    // hisob ochib, stories rasmlarini yuklashi, ALMASHTIRISHI va
    // O'CHIRISHI mumkin edi (saytning bosh sahifasiga istalgan rasm
    // qo'yish imkoni).
    // Endi `admin` yoki `superAdmin` maxsus huquqi (custom claim)
    // talab qilinadi. Bu huquq FAQAT server tomonidan beriladi
    // (admin-grant-role.js / admin-manage-admins.js), oddiy
    // foydalanuvchi o'ziga o'zi bera olmaydi.
    function adminmi() {
      return request.auth != null
        && (request.auth.token.admin == true || request.auth.token.superAdmin == true);
    }

    // Mijozlar fikri video sharhlari — hamma ko'ra oladi (saytda
    // ko'rsatiladi), faqat tizimga kirgan admin yuklashi/o'chirishi mumkin.
    match /testimonial_videos/{fileName} {
      allow read: if true;
      allow write: if adminmi()
        && request.resource.size < 100 * 1024 * 1024   // 100 MB dan katta bo'lmasin
        && request.resource.contentType.matches('video/.*');
    }

    // STORIES rasmlari (bosh sahifadagi dumaloq lenta).
    // Hamma ko'ra oladi (saytda ko'rsatiladi), yuklashni faqat tizimga
    // kirgan admin qila oladi. Chegaralar: 9 MB va FAQAT rasm fayli —
    // ya'ni bu yerga video, arxiv yoki skript yuklab bo'lmaydi.
    // (Admin panel rasmni yuborishdan oldin brauzerning o'zida siqadi:
    //  doira uchun 256x256, to'liq ekran uchun 1280 px — shu sabab
    //  haqiqatda yuklanadigan fayl odatda 200 KB atrofida bo'ladi.)
    // V85: bitta story ichida 10 tagacha RASM yoki VIDEO bo'lishi mumkin.
    // Rasm — 9 MB gacha (brauzerda 1280 px ga siqilgani uchun amalda
    // ~200 KB bo'ladi), video — 50 MB gacha (videoni brauzerda siqib
    // bo'lmaydi, shu sabab chegara kattaroq, lekin cheksiz emas:
    // mijozning interneti ham, Storage hisobi ham tejalsin).
    match /stories/{fileName} {
      allow read: if true;
      allow write: if adminmi()
        && (
          (request.resource.contentType.matches('image/.*')
            && request.resource.size < 9 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*')
            && request.resource.size < 50 * 1024 * 1024)
        );
      allow delete: if adminmi();
    }

    // "Premium video" bo'limi V118 da butunlay olib tashlandi (mijoz
    // so'rovi), shu sabab uning fayl yo'li ham YOPILDI. Eski fayllar
    // saqlanib qolsa ham, ularga yangi yuklash yoki o'qish yo'q.
    // Saytdagi pastki "sotilgan raqamlar videosi" — boshqa yo'l
    // (video_testimonials, yuqorida) va u o'z joyida qoldi.

    // HAMMA QOLGAN YO'L — YOPIQ. Firebase o'zi ham ro'yxatda yo'q
    // yo'lni taqiqlaydi, lekin bu qator niyatni aniq yozib qo'yadi:
    // yangi papka qo'shilsa, u ATAYLAB ochilishi kerak.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
