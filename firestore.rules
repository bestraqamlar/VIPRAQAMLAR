rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // XAVFSIZLIK: "tizimga kirgan" (request.auth != null) va "ADMIN"
    // bir xil narsa EMAS. Agar Firebase Authentication konsolida
    // Email/Parol provayderida o'z-o'zini ro'yxatdan o'tkazish yoqilgan
    // bo'lsa (odatiy standart holat), HAR KIM ochiq Firebase Web API
    // kalitidan foydalanib o'ziga hisob ochib, keyin shu "tizimga
    // kirgan" holatdan foydalanib admin ma'lumotlariga (mijozlar
    // ro'yxati, operator login-parollari va h.k.) kira olar edi.
    //
    // DIQQAT: agar qayerdadir `isAdmin(){ return request.auth != null; }`
    // ko'rinishidagi qoida ko'rsangiz — bu XATO, JUDA XAVFLI qoida.
    // U "tizimga kirgan" bilan "ADMIN"ni farqlamaydi va yuqoridagi
    // hujum yo'lini ochib qo'yadi. To'g'ri qoida har doim quyidagicha —
    // haqiqiy admin ekanini "custom claim" (server tomonidan, faqat
    // netlify/functions/admin-grant-role.js yoki admin-manage-admins.js
    // orqali beriladigan maxsus belgi `admin: true`) bo'yicha tekshiradi:
    function isAdmin(){
      return request.auth != null && request.auth.token.admin == true;
    }

    // BOSH ADMIN (superAdmin) — bu huquq FAQAT qo'lda, maxfiy kalit
    // (ADMIN_BOOTSTRAP_SECRET) orqali admin-grant-role.js funksiyasi
    // bilan beriladi. Ilova ichidan (Boshqaruv bo'limidan) HECH QACHON
    // bu huquqni hech kimga berib bo'lmaydi — shu bilan "kimdir ilova
    // orqali o'zini bosh admin qilib olishi" mumkin emas.
    function isSuperAdmin(){
      return isAdmin() && request.auth.token.superAdmin == true;
    }

    // BO'LIM DARAJASIDAGI RUXSAT (permissions).
    // - Bosh admin — hammasiga ruxsat.
    // - "perms" claim'i UMUMAN yo'q hisoblar — bular ESKI (yangi
    //   "Boshqaruv" tizimidan OLDIN yaratilgan) adminlar; ular
    //   avvalgidek TO'LIQ huquqli qoladi (hech narsa buzilmasin deb).
    // - "perms" claim'i BOR hisoblar — bular "Boshqaruv" orqali
    //   yaratilgan sub-adminlar; faqat aniq yoqilgan bo'limlarga kira
    //   oladi. Bu — Firestore darajasida MAJBURIY tekshiruv, faqat
    //   ekranda tugmani "yashirish" emas — token soxtalashtirib
    //   bo'lmaydi, shu sabab hatto to'g'ridan-to'g'ri so'rov yuborishga
    //   urinilsa ham (masalan brauzer konsolidan) ishlamaydi.
    function hasPerm(key){
      return isAdmin() && (
        isSuperAdmin()
        || !('perms' in request.auth.token)
        || (key in request.auth.token.perms && request.auth.token.perms[key] == 1)
      );
    }

    // Faqat ko'rsatilgan maydonlar o'zgarganini tekshiradi — takrorlanadigan
    // ".diff(resource.data).affectedKeys().hasOnly([...])" o'rniga.
    function changedOnly(keys){
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Like qiymatini faqat 1 taga oshirish yoki kamaytirish (like/unlike).
    function isValidLikeToggle(resourceBefore, dataAfter){
      return dataAfter.diff(resourceBefore.data).affectedKeys().hasOnly(['likes'])
        && dataAfter.likes is number
        && dataAfter.likes >= 0
        && (
          (!resourceBefore.data.keys().hasAll(['likes']) && dataAfter.likes == 1)
          || (resourceBefore.data.likes is number
              && (dataAfter.likes == resourceBefore.data.likes + 1
                  || dataAfter.likes == resourceBefore.data.likes - 1))
        );
    }

    match /numbers/{doc} {
      allow read: if true;
      allow create, delete: if hasPerm('numbers');
      allow update: if hasPerm('numbers')
        // Anonim mijoz raqamni "band" qila oladi, LEKIN faqat 'reserved' va
        // 'reservedAt' ikkalasini birga, va reservedAt aynan server vaqtiga
        // teng bo'lishi shart (soxtalashtirib bo'lmaydi). Bu yozuv bilan
        // birga netlify/functions/release-stale-reservations.js muntazam
        // ishlab, orqasida haqiqiy buyurtma bo'lmagan "band"larni avtomatik
        // bo'shatadi — shu bilan anonim spam orqali butun katalogni
        // "band qilib qo'yish" hujumi zararsizlantiriladi.
        || (changedOnly(['reserved', 'reservedAt'])
            && resource.data.reserved == false
            && request.resource.data.reserved == true
            && request.resource.data.reservedAt == request.time)
        || (changedOnly(['views'])
            && request.resource.data.views is number
            && (
              (!(resource.data.views is number)
                && request.resource.data.views >= 800
                && request.resource.data.views <= 1500)
              ||
              (resource.data.views is number
                && request.resource.data.views == resource.data.views + 1)
            ));
    }

    match /orders/{doc} {
      // Hujjat hajmi cheklangan (spam/keraksiz katta yozuvlarning oldini
      // olish uchun) — public foydalanuvchi FAQAT yangi buyurtma yarata
      // oladi, boshqa hech narsa qila olmaydi.
      allow create: if request.resource.data.keys().size() <= 20
        && request.resource.data.status == 'Yangi'
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.phone is string && request.resource.data.phone.size() < 50
        && request.resource.data.region is string && request.resource.data.region.size() < 300;
      allow read, update, delete: if hasPerm('orders');
    }

    match /admin_meta/{doc} {
      allow read, write: if isAdmin();
    }

    match /admin_sessions/{doc} {
      // Har bir admin O'ZINING kirish/chiqish yozuvini qo'sha oladi (audit
      // uchun — "Seanslar" ruxsati bo'lmasa ham, o'z tarixi yozilaveradi).
      // uid maydoni albatta so'rov yuborayotgan hisobning O'ZINIKI bo'lishi
      // shart — aks holda kimdir boshqa admin nomidan soxta yozuv qo'sha
      // olar edi.
      allow create: if isAdmin() && request.resource.data.uid == request.auth.uid;
      // Ro'yxatni FAQAT "Seanslar" bo'limiga ruxsati borlar (yoki bosh
      // admin) ko'ra oladi — boshqa adminlarning kirish tarixi tijorat
      // siri kabi qaraladi.
      allow read: if hasPerm('sessions');
    }

    match /site_settings/{doc} {
      allow read: if true;
      // "instagram_bot" va "telegram_bot" hujjatlari mos ravishda
      // Instagram AI / Telegram AI bo'limlariga tegishli — faqat o'sha
      // bo'limga ruxsati borlar o'zgartira oladi. "general" hujjati esa
      // "Uslublar" VA "Sozlamalar" ikkala bo'lim tomonidan ham
      // ishlatiladi, shu sabab ikkalasidan biriga ruxsat bo'lsa yetarli.
      allow write: if
        (doc == 'instagram_bot' && hasPerm('instagram'))
        || (doc == 'telegram_bot' && hasPerm('telegramai'))
        || (doc != 'instagram_bot' && doc != 'telegram_bot' && (hasPerm('styles') || hasPerm('settings')));
    }

    match /active_sessions/{doc} {
      // lastSeen soxtalashtirib bo'lmasin (masalan kelajakka yoki
      // o'tmishga sanalangan qiymat yozilmasin) deb aynan server
      // vaqtiga tenglashtirilishi shart qilindi — shunchaki "timestamp
      // turi bo'lsa bas" emas, chunki mijoz o'z brauzeri soatini
      // o'zgartirib, soxta vaqt yubora olardi.
      allow create: if request.resource.data.keys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen == request.time;
      allow update: if isAdmin()
        || (changedOnly(['lastSeen']) && request.resource.data.lastSeen == request.time);
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    match /site_stats/{doc} {
      allow read: if true;
      // "counter" hujjati faqat +1 qadam bilan o'sishi mumkin — shu bilan
      // anonim tomondan ixtiyoriy/manfiy qiymat yozib qo'yish oldi olinadi
      // (xuddi 'numbers.views' uchun qilingani kabi).
      allow create: if isAdmin()
        || (doc == 'counter' && request.resource.data.keys().hasOnly(['totalVisitors'])
            && request.resource.data.totalVisitors == 1);
      allow update: if isAdmin()
        || (doc == 'counter'
            && changedOnly(['totalVisitors'])
            && request.resource.data.totalVisitors is number
            && resource.data.totalVisitors is number
            && request.resource.data.totalVisitors == resource.data.totalVisitors + 1);
      allow delete: if isAdmin();
    }

    match /promo_codes/{doc} {
      allow read, write: if hasPerm('settings');
    }

    // Operator API sozlamalari — ichida Beeline LOGIN/PAROLI bor, shu sabab
    // ommaga OCHIQ EMAS. Faqat "Operatorlar" bo'limiga ruxsati bor admin
    // o'qiy/yoza oladi — HECH QACHON oddiy "request.auth != null"ga
    // ochilmaydi, chunki bu Beeline va boshqa operator hisoblarini butun
    // internet oldida ochiq qilib qo'yardi. Netlify funksiyasi
    // (api-live-search) buni Admin SDK orqali o'qiydi — u bu qoidalardan
    // o'tmaydi, shuning uchun read'ni ochish shart emas.
    match /operator_config/{doc} {
      allow read, write: if hasPerm('operators');
    }

    match /number_price_categories/{doc} {
      allow read: if true;
      allow write: if hasPerm('zakaz');
    }

    match /custom_orders/{doc} {
      allow create: if request.resource.data.keys().size() <= 20
        && request.resource.data.status == 'Yangi'
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.phone is string && request.resource.data.phone.size() < 50
        && request.resource.data.region is string && request.resource.data.region.size() < 300
        && request.resource.data.pattern is string && request.resource.data.pattern.size() == 4;
      allow read, update, delete: if hasPerm('zakaz');
    }

    match /credit_contracts/{doc} {
      allow get, list: if hasPerm('credit');
      allow write: if hasPerm('credit');
    }

    // STANDART (jonli, operatordan qidirilgan) raqamlar uchun Firestore'da
    // haqiqiy 'numbers' hujjati yo'q — shu sabab ular uchun "band qilish"
    // (numbers.reserved kabi) qo'llanilmaydi. IKKI mijoz AYNAN BIR XIL
    // jonli raqamga bir vaqtda buyurtma bermasin deb, shu yerda YENGIL
    // "qulf" hujjati ishlatiladi: raqam bo'yicha hujjat FAQAT BIR MARTA
    // (hali mavjud bo'lmasa) yaratilishi mumkin — ikkinchi mijozning
    // urinishi (hujjat allaqachon bor bo'lgani uchun) rad etiladi.
    // Buni index.html'dagi finalizeOrder() Firestore TRANZAKSIYASI
    // orqali ishlatadi. MUHIM: bu kolleksiyani qoidalardan butunlay olib
    // tashlamang — shunday qilinsa jonli raqam qidirish/buyurtma berish
    // butunlay ishlamay qoladi (Firestore ro'yxatga olinmagan yo'llarni
    // avtomatik YOPIQ qiladi).
    match /live_reservations/{doc} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['reservedAt'])
        && request.resource.data.reservedAt == request.time;
      allow list, update, delete: if isAdmin();
    }

    match /promo_usage/{doc} {
      // usedAt aynan server vaqtiga teng bo'lishi shart — shu bilan
      // hech bo'lmasa soxta/eski-sanalangan yozuvlar oldini olamiz.
      // Hujjatda BOSHQA hech qanday maydon bo'lishi mumkin emas (faqat
      // "biror narsa yozilgan bormi" tekshiriladi, shu sabab qat'iy sxema
      // — "keys().size() <= 10" kabi bo'sh chegaraga qaraganda ancha
      // xavfsizroq).
      // ESLATMA: bu yerda hujjat ID'si (numberId) 'numbers' to'plamidan
      // ochiq o'qilishi mumkinligi sabab, chetdan har bir raqam uchun
      // oldindan "ishlatilgan" belgisi qo'yib, promo-kodlarni butunlay
      // ishlatib bo'lmas holga keltirish nazariy jihatdan hamon mumkin.
      // Buni to'liq yopish uchun bu yozuvni Netlify funksiyasiga
      // (server-tarafga) ko'chirish kerak bo'ladi — hozircha past xavf
      // deb baholanib, kelajakdagi ishga qoldirilmoqda.
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['usedAt'])
        && request.resource.data.usedAt == request.time;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /video_testimonials/{doc} {
      allow read: if true;
      allow create, delete: if hasPerm('videos');
      allow update: if hasPerm('videos')
        || isValidLikeToggle(resource, request.resource.data);
    }

    match /premium_number_videos/{doc} {
      allow read: if true;
      allow create, delete: if hasPerm('premiumvideo');
      allow update: if hasPerm('premiumvideo')
        || isValidLikeToggle(resource, request.resource.data);
    }

    // MUHIM: quyidagi kolleksiyalar faqat Netlify funksiyalari (Telegram
    // botlar, admin AI yordamchisi, admin-manage-admins.js) orqali,
    // Firebase Admin SDK bilan ishlatiladi — brauzerdan (Firestore Client
    // SDK orqali) kirish mutlaqo kerak emas, shu sabab ularga match bloki
    // ATAYLAB YOZILMAGAN (Firestore standart bo'yicha ro'yxatga
    // olinmagan yo'llarni to'liq YOPIQ qiladi — "request.auth != null"
    // kabi umumiy qoida bilan OCHIB QO'YISH XATO bo'lardi):
    // bot_sessions, known_customers_tgmenu, known_customers, admin_list,
    // admin_ai_pending_actions, number_watches (— "Baza raqam" kuzatuvi:
    // qaysi raqamlar kuzatilayotgani tijorat siri, shu sabab hatto admin
    // ham brauzerdan to'g'ridan-to'g'ri emas, faqat requireAdmin() bilan
    // himoyalangan admin-number-watch.js funksiyasi orqali kira oladi),
    // admins (— "Boshqaruv": qaysi sub-adminlar borligi, ularning
    // ruxsatlari — faqat admin-manage-admins.js orqali,
    // requireSuperAdmin() bilan himoyalangan; brauzerdan to'g'ridan-
    // to'g'ri o'qib bo'lmaydi).
  }
}
